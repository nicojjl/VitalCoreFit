  <property name="styleSheet">
   <string notr="true">
/* 1FONDOS GENERALES  */

QMainWindow {
    background-color: #0F1722;
}

/* Forzar el fondo oscuro en las páginas internas */
QStackedWidget, QStackedWidget &gt; QWidget {
    background-color: #0F1722;
}


/* BARRA DE NAVEGACIÓN LATERAL */

QListWidget {
    background-color: #1E2736;
    border: none;
    outline: none;
    padding-top: 20px;
}

QListWidget::item {
    color: #A0AAB5;
    min-height: 40px;
    padding-left: 15px;
    border-radius: 8px;
    margin: 5px 10px 5px 10px;
    font-family: &quot;Segoe UI&quot;, Arial;
    font-size: 14px;
}

QListWidget::item:hover {
    background-color: #2A3648;
    color: white;
}

QListWidget::item:selected {
    background-color: #00E5FF;
    color: #000000;
    font-weight: bold;
}

/* DASHBOARD (TARJETAS Y MACROS)*/

QFrame#tarjetaConsumidas, 
QFrame#tarjetaQuemadas, 
QFrame#tarjetaBalance, 
QFrame#tarjetaMacros {
    background-color: #1E2736;
    border-radius: 12px;
}

/* Letras blancas para los títulos de las tarjetas */
QFrame#tarjetaConsumidas QLabel, 
QFrame#tarjetaQuemadas QLabel, 
QFrame#tarjetaBalance QLabel,
QFrame#tarjetaMacros QLabel {
    color: #FFFFFF;
    font-weight: bold;
    font-size: 12px;
}

/* Destacar los números grandes de las tarjetas en Cian */
QLabel#lblCaloriasConsumidas, 
QLabel#lblCaloriasQuemadas, 
QLabel#lblBalanceNeto {
    color: #00E5FF;
    font-size: 18px;
}

/* Barras de Progreso */
QProgressBar {
    background-color: #2A3648;
    border: none;
    border-radius: 5px;
    height: 8px;
    color: transparent;
}
QProgressBar::chunk {
    border-radius: 5px;
}
QProgressBar#barProteinas::chunk { background-color: #00E676; }
QProgressBar#barCarbos::chunk { background-color: #FF9100; }
QProgressBar#barGrasas::chunk { background-color: #FF1744; }


/* MÓDULO DE NUTRICIÓN*/

QLineEdit#buscadorAlimentos {
    background-color: #1E2736;
    color: #FFFFFF;
    border: 2px solid #2A3648;
    border-radius: 8px;
    padding: 10px;
    font-size: 14px;
    font-family: &quot;Segoe UI&quot;, Arial;
}
QLineEdit#buscadorAlimentos:focus {
    border: 2px solid #00E5FF;
    background-color: #151D29;
}

QListWidget#listaComidasHoy {
    background-color: #1E2736;
    border-radius: 12px;
    border: 1px solid #2A3648;
    padding: 10px;
    outline: none;
}
QListWidget#listaComidasHoy::item {
    background-color: #0F1722;
    border-radius: 6px;
    border-left: 4px solid #00E676;
    color: white;
    padding: 10px;
    margin-bottom: 5px;
}

/* MÓDULO DE ENTRENAMIENTO*/

QTabWidget::pane {
    border: none;
    background-color: #0F1722;
}
QTabBar::tab {
    background-color: #1E2736;
    color: #A0AAB5;
    padding: 8px 20px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}
QTabBar::tab:selected {
    background-color: #2A3648;
    color: #00E5FF;
    font-weight: bold;
    border-bottom: 2px solid #00E5FF;
}

QComboBox#comboDiasRutina {
    background-color: #1E2736;
    color: white;
    border: 2px solid #2A3648;
    border-radius: 6px;
    padding: 5px 15px;
    font-weight: bold;
    font-size: 14px;
}
QComboBox#comboDiasRutina::drop-down {
    border: none;
}

QTableWidget#tablaRutina {
    background-color: #1E2736;
    color: #FFFFFF;
    border: 1px solid #2A3648;
    border-radius: 8px;
    gridline-color: #2A3648;
    selection-background-color: #00E5FF;
    selection-color: #000000;
    font-size: 13px;
    outline: none;
}
QHeaderView::section {
    background-color: #0F1722;
    color: #A0AAB5;
    padding: 6px;
    border: none;
    font-weight: bold;
    border-bottom: 1px solid #2A3648;
    border-right: 1px solid #2A3648;
}
QTableCornerButton::section {
    background-color: #0F1722;
    border: none;
}

/* MÓDULO DE PERFIL Y BOTONES  */

QPushButton#btnGuardarPerfil {
    background-color: #00E5FF;
    color: #000000;
    border: none;
    border-radius: 8px;
    padding: 12px;
    font-weight: bold;
    font-size: 14px;
    font-family: &quot;Segoe UI&quot;, Arial;
}
QPushButton#btnGuardarPerfil:hover {
    background-color: #33EEFF;
}
QPushButton#btnGuardarPerfil:pressed {
    background-color: #00B8CC;
}

/* Ajuste sutil para las etiquetas del formulario de perfil */
QWidget#perfil QLabel {
    color: #A0AAB5;
    font-weight: bold;
}
/* Botones del módulo de nutrición */
QPushButton#btnAgregarComida, QPushButton#btnHistorialComidas, QPushButton#btnVolverNutricion {
    background-color: #1E2736;
    color: #FFFFFF;
    border: 1px solid #2A3648;
    border-radius: 8px;
    padding: 10px;
    font-size: 14px;
    font-weight: bold;
}
QPushButton#btnAgregarComida:hover, QPushButton#btnHistorialComidas:hover, QPushButton#btnVolverNutricion:hover {
    background-color: #2A3648;
    border: 1px solid #00E5FF;
    color: #00E5FF;
}

/* Nuevo estilo de la lista de búsquedas */
QListWidget#listaResultadosBusqueda {
    background-color: #1E2736;
    border-radius: 8px;
    border: none;
    color: white;
    padding: 5px;
}
QListWidget#listaResultadosBusqueda::item {
    padding: 10px;
    border-bottom: 1px solid #2A3648;
}
QListWidget#listaResultadosBusqueda::item:hover {
    background-color: #2A3648;
}

/* DISEÑO DE LA PÁGINA BUSCADOR (FOTO 2)     */


/* El Buscador de arriba */
QLineEdit#buscadorAlimentos {
    background-color: #1E2736;
    color: #FFFFFF;
    border: 1px solid #2A3648;
    border-radius: 6px;
    padding: 12px;
    font-size: 14px;
}


/* El efecto Cian al pasar el mouse o seleccionar (Como en tu foto) */
QListWidget#listaResultadosBusqueda::item:hover, 
QListWidget#listaResultadosBusqueda::item:selected {
    background-color: #00E5FF;
    color: #000000;
    border-radius: 6px;
    font-weight: bold;
}

/* El botón Volver alargado de abajo */
QPushButton#btnVolverNutricion {
    background-color: #D3D3D3; 
    color: #000000;
    border: none;
    border-radius: 6px;
    padding: 10px;
    font-weight: bold;
}
QPushButton#btnVolverNutricion:hover {
    background-color: #B0B0B0;
}</string>
