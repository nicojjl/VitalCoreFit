  <property name="styleSheet">
   <string notr="true">/* Color de fondo de toda la ventana principal */
QMainWindow {
    background-color: #0F1722;
}

/* LA BARRA LATERAL (List Widget) */
QListWidget {
    background-color: #1E2736;
    border: none;
    outline: none; /* Quita el borde punteado feo al hacer clic */
    padding-top: 20px;
}

/* LOS BOTONES DE LA BARRA LATERAL */
QListWidget::item {
    color: #A0AAB5;
    min-height: 40px;
    padding-left: 15px;
    border-radius: 8px;
    margin: 5px 10px 5px 10px; /* Margen para que no toque los bordes */
    font-family: &quot;Segoe UI&quot;, Arial;
    font-size: 14px;
}

QListWidget::item:hover {
    background-color: #2A3648;
    color: white;
}

/* EL BOTÓN SELECCIONADO (Efecto Cian) */
QListWidget::item:selected {
    background-color: #00E5FF;
    color: #000000;
    font-weight: bold;
}

/* FONDO DEL ÁREA DE CONTENIDO (Stacked Widget) */
QStackedWidget {
    background-color: #0F1722;
}

/* NUEVO: ESTILO PARA LAS TARJETAS (CARDS) */

QFrame#tarjetaCalorias {
    background-color: #1E2736;
    border-radius: 12px;
}
/* El fondo de la nueva tarjeta */
QFrame#tarjetaMacros {
    background-color: #1E2736;
    border-radius: 12px;
}

/* ESTILO GENERAL DE LAS BARRAS DE PROGRESO */
QProgressBar {
    background-color: #2A3648; /* El color del &quot;camino&quot; vacío (Gris oscuro) */
    border: none;
    border-radius: 5px; /* Bordes redondeados */
    height: 8px; /* Hace la barra bien delgada y moderna */
    color: transparent; /* Oculta el porcentaje numérico del centro */
}

/* EL RELLENO DE LAS BARRAS */
QProgressBar::chunk {
    border-radius: 5px;
}

/* COLORES ESPECÍFICOS SEGÚN EL MACRONUTRIENTE */
QProgressBar#barProteinas::chunk {
    background-color: #00E676; /* Verde neón */
}

QProgressBar#barCarbos::chunk {
    background-color: #FF9100; /* Naranja */
}

QProgressBar#barGrasas::chunk {
    background-color: #FF1744; /* Rojo */
}

/* Color para los textos de los labels de esta tarjeta */
QFrame#tarjetaMacros QLabel {
    color: #FFFFFF;
    font-size: 11px;
    font-weight: bold;
}

/* MÓDULO DE NUTRICIÓN */

/* ESTILO DEL BUSCADOR DE ALIMENTOS */
QLineEdit#buscadorAlimentos {
    background-color: #1E2736;
    color: #FFFFFF;
    border: 2px solid #2A3648; /* Borde gris oscuro por defecto */
    border-radius: 8px;
    padding: 10px;
    font-size: 14px;
    font-family: &quot;Segoe UI&quot;, Arial;
}

/* EFECTO CUANDO EL USUARIO HACE CLIC PARA ESCRIBIR */
QLineEdit#buscadorAlimentos:focus {
    border: 2px solid #00E5FF; /* El borde se ilumina en Cian */
    background-color: #151D29; /* Se oscurece un poco el fondo */
}

/* ESTILO DE LA LISTA DE COMIDAS DEL DÍA */
QListWidget#listaComidasHoy {
    background-color: #1E2736;
    border-radius: 12px;
    border: 1px solid #2A3648;
    padding: 10px;
    outline: none;
}

/* Elementos dentro de la lista de comidas */
QListWidget#listaComidasHoy::item {
    background-color: #0F1722; /* Fondo más oscuro para cada comida */
    border-radius: 6px;
    border-left: 4px solid #00E676; /* Una rayita verde a la izquierda como tu prototipo */
    color: white;
    padding: 10px;
    margin-bottom: 5px;
}

/*MÓDULO DE ENTRENAMIENTO */

/* PESTAÑAS INTERNAS (Pesas / Cardio) */
QTabWidget::pane {
    border: none;
    background-color: #0F1722;
}
QTabBar::tab {
    background-color: #1E2736;
    color: #A0AAB5;
    padding: 8px 20px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}
QTabBar::tab:selected {
    background-color: #2A3648;
    color: #00E5FF;
    font-weight: bold;
    border-bottom: 2px solid #00E5FF;
}

/* COMBO BOX (Selector de días) */
QComboBox#comboDiasRutina {
    background-color: #1E2736;
    color: white;
    border: 2px solid #2A3648;
    border-radius: 6px;
    padding: 5px 15px;
    font-weight: bold;
    font-size: 14px;
}
QComboBox#comboDiasRutina::drop-down {
    border: none;
}

/* LA TABLA DE RUTINAS */
QTableWidget#tablaRutina {
    background-color: #1E2736;
    color: #FFFFFF;
    border: 1px solid #2A3648;
    border-radius: 8px;
    gridline-color: #2A3648; /* Color de las líneas de la cuadrícula */
    selection-background-color: #00E5FF; /* Celda seleccionada en cian */
    selection-color: #000000;
    font-size: 13px;
    outline: none;
}

/* ENCABEZADOS DE LA TABLA */
QHeaderView::section {
    background-color: #0F1722;
    color: #A0AAB5;
    padding: 6px;
    border: none;
    font-weight: bold;
    border-bottom: 1px solid #2A3648;
    border-right: 1px solid #2A3648;
}
QTableCornerButton::section {
    background-color: #0F1722;
    border: none;
}
/*MÓDULO DE PERFIL Y BOTONES */


/* ESTILO DEL BOTÓN PRINCIPAL */
QPushButton#btnGuardarPerfil {
    background-color: #00E5FF; /* El cian característico de la app */
    color: #000000; /* Texto negro para contraste */
    border: none;
    border-radius: 8px;
    padding: 12px;
    font-weight: bold;
    font-size: 14px;
    font-family: &quot;Segoe UI&quot;, Arial;
}

/* EFECTO HOVER (Al pasar el mouse) */
QPushButton#btnGuardarPerfil:hover {
    background-color: #33EEFF; /* Un cian un poco más claro */
}

/* EFECTO PRESSED (Al hacer clic) */
QPushButton#btnGuardarPerfil:pressed {
    background-color: #00B8CC; /* Un cian más oscuro */
}

/* Ajuste de color para las etiquetas del formulario */
QStackedWidget QLabel {
    color: #A0AAB5;
    font-weight: bold;
}</string>
